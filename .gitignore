# 학생이 자기 환경에 맞게 수정하는 파일 — 공개 저장소에 포함하지 않음.
.env
.env.local
*.local

# Wazuh SSL cert 는 첫 실행 시 generator 컨테이너가 자동 생성.
wazuh-certs/certs/*
!wazuh-certs/certs/.gitkeep

# 파이썬 부산물.
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.so

# 학생 자기 데이터 (KG, evidence DB) — 빈 상태로 시작.
src/data/*
!src/data/.keep
src/contents/threats/*
!src/contents/threats/.keep
src/contents/playbooks/*
!src/contents/playbooks/.keep

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
*~
