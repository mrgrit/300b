# =========================================================
# 300B 실습 환경 설정 (4-tier AWS-style)
# =========================================================
# 처음 한 번: 이 파일을 .env 로 복사한 뒤 LLM_BASE_URL 만 학교 GPU 서버 주소로 변경.
#   cp .env.example .env

# ----- 외부 LLM (GPU 서빙 서버) -----
LLM_BASE_URL=http://192.168.0.105:11434
LLM_MANAGER_MODEL=gpt-oss:120b
LLM_SUBAGENT_MODEL=gemma3:4b
AICOMPANION_LLM_BACKEND=mock           # mock|ollama — Phase B 후 ollama 권장

# ----- SSH 계정 (모든 컨테이너 공통) -----
SSH_USER=ccc
SSH_PASS=ccc

# ----- 외부 노출 포트 (단 3개) -----
PORT_HTTP=80                           # http://VMIP/  → fw → waf
PORT_HTTPS=443                         # https://VMIP/ → fw → waf  (Phase C 후 활성)
SSH_PORT_BASTION=2204                  # ssh ccc@VMIP -p 2204 (점프 호스트)
PORT_BASTION_API=8003                  # http://VMIP:8003  bastion 직접 (또는 bastion.300b 통해서)

# ----- Phase 토글 (단계별 활성) -----
ENABLE_DNSMASQ=false                   # Phase D 에서 true — fw 의 *.300b 사설 DNS
ENABLE_TLS=false                       # Phase C 에서 true — waf 의 self-signed CA + 443 vhost

# ----- IDS -----
SURICATA_IFACE=eth0                    # ids 컨테이너의 sniff 인터페이스 (보통 eth0=dmz)

# ----- API 인증 -----
API_KEY=300b-api-key-2026
JWT_SECRET=300b-jwt-secret-2026
