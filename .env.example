# =========================================================
# 300B 실습 환경 설정
# =========================================================
# 처음 한 번: 이 파일을 .env 로 복사한 뒤 LLM_BASE_URL 만 학교 GPU 서버 주소로 변경하세요.
#   cp .env.example .env

# ----- 외부 LLM (GPU 서빙 서버) -----
LLM_BASE_URL=http://192.168.0.105:11434
LLM_MANAGER_MODEL=gpt-oss:120b
LLM_SUBAGENT_MODEL=gemma3:4b

# ----- SSH 계정 (모든 컨테이너 공통) -----
# Windows → VM:2201~2205 로 ssh 접속할 때 사용할 계정/암호
SSH_USER=ccc
SSH_PASS=ccc

# ----- 컨테이너 SSH 호스트 포트 -----
SSH_PORT_SECU=2201
SSH_PORT_WEB=2202
SSH_PORT_SIEM=2203
SSH_PORT_BASTION=2204
SSH_PORT_ATTACKER=2205

# ----- 외부에서 직접 접속할 서비스 포트 -----
PORT_WEB_LANDING=80              # http://VMIP/   랜딩 페이지
PORT_WAZUH_DASHBOARD=1443        # https://VMIP:1443
PORT_BASTION_API=8003            # http://VMIP:8003
PORT_JUICESHOP=3000
PORT_DVWA=8080
PORT_NEOBANK=3001
PORT_GOVPORTAL=3002
PORT_MEDIFORUM=3003
PORT_ADMINCONSOLE=3004
PORT_AICOMPANION=3005

# ----- API 인증 -----
API_KEY=300b-api-key-2026
JWT_SECRET=300b-jwt-secret-2026
